    "ari-client": "^2.2.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ari-client": "^2.2.11",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0"
  }
